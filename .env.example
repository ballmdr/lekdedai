# Local development (no Docker). Copy to .env and adjust.
# ห้ามใช้ค่าไฟล์นี้ตรง ๆ ใน production — ตั้งค่าใหม่ทุกตัวที่เป็นความลับ
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# SQLite default (file db.sqlite3 at repo root). For Postgres local:
# DATABASE_URL=postgres://lekdedai_user:lekdedai_pass@localhost:5432/lekdedai
DATABASE_URL=sqlite:///db.sqlite3
# เปิดเฉพาะ dev/test ที่ต้องการข้อมูล ingestion จำลอง ห้ามเปิดใน production
# ALLOW_MOCK_INGESTION=True

# ---- Production (ไม่ใช้ Docker: gunicorn + systemd ดู deploy/) ----
# โดเมนจริงคั่นจุลภาค (ห้าม *)
# ALLOWED_HOSTS=example.com,www.example.com
# ต้นทางที่อนุญาตสำหรับ CSRF (https)
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Postgres ของเครื่องจริง/managed (ห้าม SQLite ใน production)
# DATABASE_URL=postgres://lekdedai_user:STRONG_DB_PASSWORD_HERE@127.0.0.1:5432/lekdedai
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=STRONG_ADMIN_PASSWORD_HERE
# เปิดเมื่ออยู่หลัง TLS proxy + HSTS
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
